# Copy to .env for Docker Compose. Never commit real secrets.
DEMO_MODE=true
# Set true when local-demo accounts are served over HTTPS. Production uses Supabase.
COOKIE_SECURE=false
POSTGRES_PASSWORD=local-development-only
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
TMDB_TOKEN=
ADMIN_USER_IDS=
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_ENABLE_GALAXY=false
# For non-Docker backend, export variables or put in apps/api/.env:
# DATABASE_URL=sqlite:///./cineverse.db
# DATA_DIR=../../data
# MODEL_PATH=../../data/model.npz
# REDIS_URL=redis://localhost:6379
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# For non-Docker frontend, use apps/web/.env.local:
# API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
