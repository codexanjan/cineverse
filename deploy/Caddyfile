# Reverse proxy for a single-host deployment. Point DNS to this host first.
{$DOMAIN:localhost} {
    encode zstd gzip
    request_body {
        max_size 32KB
    }
    reverse_proxy web:3000
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
}
